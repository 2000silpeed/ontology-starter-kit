# Postgres connection (PG 13+ required; gen_random_uuid is built in)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ontology

# Postgres schemas created by db/init scripts
META_SCHEMA=onto_meta
DOMAIN_SCHEMA=onto_app

# HTTP server
PORT=3456

# Agent runtime (optional). Without a key, only the HTTP layer runs.
ANTHROPIC_API_KEY=
